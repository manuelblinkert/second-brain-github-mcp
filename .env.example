# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in REAL values for local development.
# `.env` is gitignored and must never be committed.
#
# Locally: `uv run python server.py` auto-loads `.env` (no `export` needed).
# When hosting: do NOT upload a .env file. Add each of these as an encrypted
# environment variable in your platform (DigitalOcean App Platform, a VPS, etc).
# ---------------------------------------------------------------------------

# === Public URL of THIS MCP server =========================================
# The base URL where this server is reachable, with NO trailing slash. Locally
# this is http://localhost:8000; when hosted, the real assigned public URL
# (a wrong value breaks OAuth discovery). OAUTH_ISSUER_URL is the same value.
MCP_PUBLIC_BASE_URL=http://localhost:8000
OAUTH_ISSUER_URL=http://localhost:8000

# === Roster =================================================================
# Comma-separated member ids. Each id needs a matching MEMBER_<ID>_* block
# below (uppercased id as the prefix).
#
#   Single user:  TEAM_MEMBER_IDS=you   (+ one MEMBER_YOU_* block)
#   Team:         one id per member     (+ one block each)
#
# Each member needs a USERNAME (free-form login of their choice), a PASSWORD,
# and their own fine-grained GITHUB_TOKEN. The token's GitHub account is who
# that member's commits are authored as — paste each member's token carefully.
TEAM_MEMBER_IDS=you

# --- you ---
MEMBER_YOU_USERNAME=pick-a-username
MEMBER_YOU_PASSWORD=pick-a-long-random-password
MEMBER_YOU_GITHUB_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxxx

# --- add more members for a team (uncomment and duplicate per member) ---
# TEAM_MEMBER_IDS=you,teammate
# MEMBER_TEAMMATE_USERNAME=pick-a-username
# MEMBER_TEAMMATE_PASSWORD=pick-a-long-random-password
# MEMBER_TEAMMATE_GITHUB_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxxx

# === GitHub target (the one repo, fixed for all members) ====================
# Each member's fine-grained PAT above must be scoped to ONLY this repo and
# need "Contents: Read and write".
GITHUB_ALLOWED_OWNER=your-github-username-or-org
GITHUB_ALLOWED_REPO=your-second-brain-repo

# === Optional ===============================================================
# Name this instance reports on the login page and in `ping`.
# MCP_SERVER_NAME=second-brain-github-mcp
# Port the server listens on. Defaults to 8000 if unset.
# PORT=8000
